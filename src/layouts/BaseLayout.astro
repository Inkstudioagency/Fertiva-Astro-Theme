---
/**
 * Root layout shared by every page.
 *
 * The visual layer is the original Webflow design: the three stylesheets in `src/styles`
 * plus `webflow.js` (navigation, tabs, sliders, background video, Lottie and the IX3/GSAP
 * interactions). `wfPage` must be the original Webflow page id, because the IX3
 * interactions in webflow.js are scoped to it.
 */
import '../styles/normalize.css';
import '../styles/webflow.css';
import '../styles/fertiva.css';
import ix3Preload from '../styles/ix3-preload.css?raw';
import site from '../config/site.json';
import SeoMeta from '../components/global/SeoMeta.astro';
import SiteScripts from '../components/global/SiteScripts.astro';

interface Props {
  wfPage: string;
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { wfPage, ...seo } = Astro.props;
---

<!doctype html>
<html data-wf-page={wfPage} data-wf-site={site.webflow.siteId} lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <SeoMeta {...seo} />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta name="generator" content={Astro.generator} />
    <style is:inline set:html={ix3Preload}></style>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <script is:inline src="/js/vendor/webfont.js"></script>
    <script is:inline>
      WebFont.load({ google: { families: ['Instrument Serif:400', 'Plus Jakarta Sans:400,500,600,700'] } });
    </script>
    <script is:inline>
      !(function (o, c) {
        var n = c.documentElement,
          t = ' w-mod-';
        (n.className += t + 'js'), ('ontouchstart' in o || (o.DocumentTouch && c instanceof DocumentTouch)) && (n.className += t + 'touch');
      })(window, document);
    </script>
    <link href="/images/favicon.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link href="/images/favicon-48.png" rel="icon" type="image/png" sizes="48x48" />
    <link href="/images/webclip-180.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/images/webclip-192.png" rel="icon" type="image/png" sizes="192x192" />
    <link href="/images/webclip.png" rel="icon" type="image/png" sizes="512x512" />
  </head>
  <body>
    <slot />
    <SiteScripts />
  </body>
</html>
