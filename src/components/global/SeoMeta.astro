---
/**
 * SEO + social meta tags. Every page passes its own title/description;
 * defaults come from `src/config/site.json`.
 */
import site from '../../config/site.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title = site.title, description = site.description, image = site.ogImage, type = 'website', noindex = false } = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imageUrl = image && Astro.site && image.startsWith('/') ? new URL(image, Astro.site).href : image;
---

<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
<meta property="og:type" content={type} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:site_name" content={site.name} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
