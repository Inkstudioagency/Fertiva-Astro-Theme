              </svg></div>
            <div class="contact-info-group">
              <div class="font-small warm">Email</div>
              <div class="contact-number-wrap">
                <a href="mailto:care@example.com" class="contact-number">care@example.com</a>
                <a href="mailto:support@example.com" class="contact-number">support@example.com</a>
              </div>
            </div>
          </div>
          <div to-top-4="" class="contact-card-v3">
            <div class="phone-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="phone-icon">
                <path d="M20 9.99994C20 15.9999 12 21.9999 12 21.9999C12 21.9999 4 15.9999 4 9.99994C4 7.87821 4.84285 5.84338 6.34315 4.34308C7.84344 2.84279 9.87827 1.99994 12 1.99994C14.1217 1.99994 16.1566 2.84279 17.6569 4.34308C19.1571 5.84338 20 7.87821 20 9.99994Z" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"></path>
