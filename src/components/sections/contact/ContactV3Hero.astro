---
import Navbar from '../../global/Navbar.astro';
import PrimaryButton from '../../ui/PrimaryButton.astro';
---
<div class="hero-wrap">
    <Navbar variant="base" />
    <section class="hero-section v3">
      <div class="container">
        <div class="v3-hero-content">
          <div class="v2-hero-top center">
            <div class="badge contact">
              <div class="badge-dot"></div>
              <div>Contact Us</div>
            </div>
            <h1 class="service-title">Get in touch with our care team</h1>
          </div>
        </div>
        <div class="contact-grid-v3">
          <div class="contact-left">
            <div class="cta-form-card contact-form-wrap-v3">
              <div class="font-medium semibold">Patient information</div>
              <div class="cta-form">
                <div class="cta-form w-form">
                  <form id="wf-form-Contact-V3-Form" name="wf-form-Contact-V3-Form" data-name="Contact V3 Form" method="get" class="contact-form-v2" data-wf-page-id="6b03d34f707687d1b49b567f" data-wf-element-id="c877d5c2-430b-38df-87bb-015cf8239c66">
                    <div class="cta-fields">
                      <div class="cta-field-row">
                        <div class="cta-field"><label for="v3-name" class="cta-label">Full name</label><input class="cta-input w-input" maxlength="256" name="v3-name" data-name="v3-name" placeholder="John Doe" type="text" id="v3-name" required=""></div>
                        <div class="cta-field"><label for="v3-phone" class="cta-label">Contact number</label><input class="cta-input w-input" maxlength="256" name="v3-phone" data-name="v3-phone" placeholder="+65 8787 8868" type="tel" id="v3-phone" required=""></div>
                      </div>
                      <div class="cta-field-row">
                        <div class="cta-field"><label for="v3-date" class="cta-label">Preferred appointment date</label><input class="cta-input w-input" maxlength="256" name="v3-date" data-name="v3-date" placeholder="Example text" type="date" id="v3-date"></div>
                        <div class="cta-field"><label for="Select" class="cta-label">Preferred appointment time</label><select id="Select" name="Select" data-name="Select" class="cta-input w-select">
                            <option value="">Select one...</option>
                            <option value="Morning">Morning (8 AM - 12 PM)</option>
                            <option value="Afternoon">Afternoon (12 PM - 4 PM)</option>
                            <option value="Evening">Evening (4 PM - 8 PM)</option>
                          </select></div>
                      </div>
                      <div class="cta-field"><label for="Service-Select" class="cta-label">Service type</label><select id="Service-Select" name="Service-Select" data-name="Service Select" class="cta-input select w-select">
                          <option value="">Select service</option>
                          <option value="Fertility">Fertility care</option>
                          <option value="Pregnancy">Pregnancy care</option>
                          <option value="Hormonal">Hormonal health</option>
                          <option value="Gynecology">Gynecology</option>
                        </select></div>
                      <div class="cta-field"><label for="" class="cta-label">Tell us about your health</label><textarea placeholder="Enter your message" maxlength="5000" id="field" name="contact-v2-message" data-name="contact-v2-message" class="cta-input textarea w-input"></textarea></div>
                    </div><input type="submit" data-wait="Please wait..." class="cta-submit w-button" value="Book appointment">
                  </form>
                  <div class="success-message w-form-done">
                    <div>Thanks for reaching out! We&#x27;ll be in touch very soon.</div>
                  </div>
                  <div class="error-message w-form-fail">
                    <div>Sorry, we couldn&#x27;t send that. Please try again soon.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="contact-right">
            <div data-poster-url="/videos/0_Pregnancy_Ultrasound_1920x1080.mp4-1_poster.0000000.jpg" data-video-urls="/videos/0_Pregnancy_Ultrasound_1920x1080.mp4-1_mp4.mp4,/videos/0_Pregnancy_Ultrasound_1920x1080.mp4-1_webm.webm" data-autoplay="true" data-loop="true" data-wf-ignore="true" class="contact-video w-background-video w-background-video-atom"><video id="97067629-11c3-1bfb-806b-5da07e6d2a92-video" autoplay="" loop="" style="background-image:url(&quot;/videos/0_Pregnancy_Ultrasound_1920x1080.mp4-1_poster.0000000.jpg&quot;)" muted="" playsinline="" data-wf-ignore="true" data-object-fit="cover">
                <source src="/videos/0_Pregnancy_Ultrasound_1920x1080.mp4-1_mp4.mp4" data-wf-ignore="true">
                <source src="/videos/0_Pregnancy_Ultrasound_1920x1080.mp4-1_webm.webm" data-wf-ignore="true">
              </video><noscript>
                <style is:inline>
[data-wf-bgvideo-fallback-img] {
  display: none;
}
@media (prefers-reduced-motion: reduce) {
  [data-wf-bgvideo-fallback-img] {
    position: absolute;
    z-index: -100;
    display: inline-block;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
}</style><img data-wf-bgvideo-fallback-img="true" src="/videos/0_Pregnancy_Ultrasound_1920x1080.mp4-1_poster.0000000.jpg" alt="">
              </noscript>
              <div aria-live="polite"><button type="button" data-w-bg-video-control="true" aria-controls="97067629-11c3-1bfb-806b-5da07e6d2a92-video" class="w-backgroundvideo-backgroundvideoplaypausebutton video-button w-background-video--control"><span class="play-pouse-state"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="play-pouse-icon">
                      <path d="M20 7C20 5.58579 20 4.87868 19.5607 4.43934C19.1213 4 18.4142 4 17 4C15.5858 4 14.8787 4 14.4393 4.43934C14 4.87868 14 5.58579 14 7V17C14 18.4142 14 19.1213 14.4393 19.5607C14.8787 20 15.5858 20 17 20C18.4142 20 19.1213 20 19.5607 19.5607C20 19.1213 20 18.4142 20 17V7Z" stroke-width="1.5" stroke="currentColor"></path>
                      <path d="M10 7C10 5.58579 10 4.87868 9.5607 4.43934C9.1213 4 8.4142 4 7 4C5.5858 4 4.8787 4 4.4393 4.43934C4 4.87868 4 5.58579 4 7V17C4 18.4142 4 19.1213 4.4393 19.5607C4.8787 20 5.5858 20 7 20C8.4142 20 9.1213 20 9.5607 19.5607C10 19.1213 10 18.4142 10 17V7Z" stroke-width="1.5" stroke="currentColor"></path>
                    </svg></span><span hidden="" class="play-pouse-state"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="play-pouse-icon">
                      <path d="M18.8906 12.846C18.5371 14.189 16.8667 15.138 13.5257 17.0361C10.296 18.8709 8.6812 19.7884 7.37983 19.4196C6.8418 19.2671 6.35159 18.9776 5.95624 18.5787C5 17.6139 5 15.7426 5 12C5 8.2574 5 6.3861 5.95624 5.42132C6.35159 5.02245 6.8418 4.73288 7.37983 4.58042C8.6812 4.21165 10.296 5.12907 13.5257 6.96393C16.8667 8.86197 18.5371 9.811 18.8906 11.154C19.0365 11.7084 19.0365 12.2916 18.8906 12.846Z" stroke-width="1.5" stroke-linejoin="round" stroke="currentColor"></path>
                    </svg></span></button></div>
            </div>
            <div class="contact-card">
              <div class="contact-card-top">
                <div class="contact-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="contact-icon-v3">
                    <path d="M3 11H6C6.53043 11 7.03914 11.2107 7.41421 11.5858C7.78929 11.9609 8 12.4696 8 13V16C8 16.5304 7.78929 17.0391 7.41421 17.4142C7.03914 17.7893 6.53043 18 6 18H5C4.46957 18 3.96086 17.7893 3.58579 17.4142C3.21071 17.0391 3 16.5304 3 16V11ZM3 11C3 9.8181 3.23279 8.64778 3.68508 7.55585C4.13738 6.46392 4.80031 5.47177 5.63604 4.63604C6.47177 3.80031 7.46392 3.13738 8.55585 2.68508C9.64778 2.23279 10.8181 2 12 2C13.1819 2 14.3522 2.23279 15.4442 2.68508C16.5361 3.13738 17.5282 3.80031 18.364 4.63604C19.1997 5.47177 19.8626 6.46392 20.3149 7.55585C20.7672 8.64778 21 9.8181 21 11M21 11V16C21 16.5304 20.7893 17.0391 20.4142 17.4142C20.0391 17.7893 19.5304 18 19 18H18C17.4696 18 16.9609 17.7893 16.5858 17.4142C16.2107 17.0391 16 16.5304 16 16V13C16 12.4696 16.2107 11.9609 16.5858 11.5858C16.9609 11.2107 17.4696 11 18 11H21Z" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"></path>
                    <path d="M21 16V18C21 19.0609 20.5786 20.0783 19.8284 20.8284C19.0783 21.5786 18.0609 22 17 22H12" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"></path>
                  </svg></div>
                <div class="inner-badge">
                  <div>Open 24/7</div>
                </div>
              </div>
              <div class="contact-card-title-wrap">
                <div class="font-medium semibold white">Emergency cases</div>
                <p class="contact-summary">For urgent pregnancy or medical concerns, call our nurse line any time, day or night.</p>
              </div>
              <PrimaryButton href="tel:+1(312)555-0199" label="+1 (312) 555-0199" />
            </div>
          </div>
        </div>
        <div class="contact-card-grid">
          <div to-top-0="" class="contact-card-v3">
            <div class="phone-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="phone-icon">
                <path d="M21.9994 16.92V19.92C22.0006 20.1985 21.9435 20.4741 21.832 20.7293C21.7204 20.9845 21.5567 21.2136 21.3515 21.4018C21.1463 21.5901 20.904 21.7335 20.6402 21.8227C20.3764 21.9119 20.0968 21.945 19.8194 21.92C16.7424 21.5853 13.7866 20.5338 11.1894 18.85C8.77327 17.3146 6.72478 15.2661 5.18945 12.85C3.49976 10.241 2.44806 7.27089 2.11944 4.17997C2.09446 3.90344 2.12732 3.62474 2.21595 3.3616C2.30457 3.09846 2.44702 2.85666 2.63421 2.6516C2.82141 2.44653 3.04925 2.28268 3.30324 2.1705C3.55722 2.05831 3.83179 2.00024 4.10945 1.99997H7.10945C7.59475 1.9952 8.06524 2.16705 8.43321 2.48351C8.80118 2.79996 9.04152 3.23942 9.10944 3.71997C9.23944 4.67997 9.46945 5.61997 9.80945 6.52997C9.94399 6.8879 9.97311 7.27689 9.89335 7.65086C9.8136 8.02482 9.62831 8.36809 9.35944 8.63998L8.08945 9.90997C9.513 12.4135 11.5859 14.4864 14.0894 15.91L15.3594 14.64C15.6313 14.3711 15.9746 14.1858 16.3486 14.1061C16.7225 14.0263 17.1115 14.0554 17.4694 14.19C18.3794 14.53 19.3194 14.76 20.2794 14.89C20.7652 14.9585 21.2088 15.2032 21.526 15.5775C21.8431 15.9518 22.0116 16.4296 21.9994 16.92Z" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"></path>
              </svg></div>
            <div class="contact-info-group">
              <div class="font-small warm">Phone</div>
              <div class="contact-number-wrap">
                <a href="tel:+1(312)555-0142" class="contact-number">+1 (312) 555-0142</a>
                <a href="tel:+1(312)555-0100" class="contact-number">+1 (312) 555-0100</a>
              </div>
            </div>
          </div>
          <div to-top-2="" class="contact-card-v3">
            <div class="phone-icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="phone-icon">
                <path d="M4 4.00006H20C21.1046 4.00006 22 4.89549 22 6.00006V18.0001C22 19.1046 21.1046 20.0001 20 20.0001H4C2.89543 20.0001 2 19.1046 2 18.0001V6.00006C2 4.89549 2.89543 4.00006 4 4.00006Z" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"></path>
