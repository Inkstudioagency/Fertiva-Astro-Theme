---
interface Props {
  /** Webflow page id of the page rendering this section. */
  wfPage: string;
  /** Open the map link in a new tab (home page behaviour). */
  mapNewTab?: boolean;
}

const { wfPage, mapNewTab = false } = Astro.props;
---
<section class="cta-section">
  <div class="cta-inner">
    <div class="container">
      <div class="cta-grid">
        <div to-top-0="" class="cta-info-card">
          <div class="cta-stack">
            <div class="cta-eyebrow">
              <div class="cta-dot"></div>
              <div>A simple start</div>
            </div>
            <h2 class="cta-title">Happy to guide you.</h2>
          </div>
          <div class="cta-stack">
            <div class="cta-detail">
              <div class="cta-detail-label">Monday – Friday</div>
              <div class="cta-detail-value">8:00 AM – 6:00 PM</div>
            </div>
            <div class="cta-divider"></div>
            <div class="cta-detail">
              <div class="cta-detail-label">Saturday</div>
              <div class="cta-detail-value">9:00 AM – 2:00 PM</div>
            </div>
            <div class="cta-divider"></div>
          </div>
          <div class="cta-location">
            <div class="cta-detail">
              <div class="cta-detail-label">Clinic location</div>
              <div class="cta-detail-value">House 12, Road 90, Gulshan 2, Dhaka 1212, Bangladesh</div>
            </div>
            <a href="https://maps.google.com" target={mapNewTab ? '_blank' : undefined} class="cta-map-button w-inline-block"><svg fill="none" viewBox="0 0 24 24" width="100%" xmlns="http://www.w3.org/2000/svg" class="cta-map-icon cta-map-icon">
                <path stroke-width="1.5" stroke="currentColor" d="M14.5 9C14.5 10.3807 13.3807 11.5 12 11.5C10.6193 11.5 9.5 10.3807 9.5 9C9.5 7.61929 10.6193 6.5 12 6.5C13.3807 6.5 14.5 7.61929 14.5 9Z"></path>
                <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M18.2222 17C19.6167 18.9885 20.2838 20.0475 19.8865 20.8999C19.8466 20.9854 19.7999 21.0679 19.7469 21.1467C19.1724 22 17.6875 22 14.7178 22H9.28223C6.31251 22 4.82765 22 4.25311 21.1467C4.20005 21.0679 4.15339 20.9854 4.11355 20.8999C3.71619 20.0475 4.38326 18.9885 5.77778 17"></path>
                <path stroke-width="1.5" stroke="currentColor" d="M13.2574 17.4936C12.9201 17.8184 12.4693 18 12.0002 18C11.531 18 11.0802 17.8184 10.7429 17.4936C7.6543 14.5008 3.51519 11.1575 5.53371 6.30373C6.6251 3.67932 9.24494 2 12.0002 2C14.7554 2 17.3752 3.67933 18.4666 6.30373C20.4826 11.1514 16.3536 14.5111 13.2574 17.4936Z"></path>
              </svg>
              <div>Open Clinic Map</div>
            </a>
          </div>
        </div>
        <div to-top-2="" class="cta-form-card">
          <h3 class="faq-contact-title">Patient information</h3>
          <div class="cta-form-block w-form">
            <form id="wf-form-CTA-Appointment-Form" name="wf-form-CTA-Appointment-Form" data-name="CTA Appointment Form" method="get" class="cta-form" data-wf-page-id={wfPage} data-wf-element-id="62bb1028-0bdf-6d73-e7ee-c8c33fe8764e">
              <div class="cta-fields">
                <div class="cta-field-row">
                  <div class="cta-field"><label for="" class="cta-label">Full name</label><input class="cta-input w-input" maxlength="256" name="full-name" data-name="full-name" aria-label="Full name" placeholder="John Doe" type="text" id="full-name" required=""></div>
                  <div class="cta-field"><label for="" class="cta-label">Contact number</label><input class="cta-input w-input" maxlength="256" name="phone" data-name="phone" aria-label="Contact number" placeholder="+880 1712 345678" type="tel" id="phone" required=""></div>
                </div>
                <div class="cta-field-row">
                  <div class="cta-field"><label for="" class="cta-label">Preferred appointment date</label><input class="cta-input w-input" maxlength="256" name="appointment-date" data-name="appointment-date" aria-label="Preferred appointment date" placeholder="Select a date" type="date" id="appointment-date"></div>
                  <div class="cta-field"><label for="" class="cta-label">Preferred appointment time</label><select id="appointment-time" name="appointment-time" data-name="appointment-time" aria-label="Preferred appointment time" class="cta-input w-select">
                      <option value="">Select one...</option>
                      <option value="Morning">Morning (8 AM – 12 PM)</option>
                      <option value="Afternoon">Afternoon (12 PM – 4 PM)</option>
                      <option value="Evening">Evening (4 PM – 6 PM)</option>
                    </select></div>
                </div>
                <div class="cta-field"><label for="" class="cta-label">Service type</label><select id="service" name="service" data-name="service" aria-label="Service type" class="cta-input w-select">
                    <option value="">Select service</option>
                    <option value="Fertility testing">Fertility testing</option>
                    <option value="Egg freezing">Egg freezing</option>
                    <option value="IVF treatment">IVF treatment</option>
                    <option value="IUI treatment">IUI treatment</option>
                  </select></div>
                <div class="cta-field"><label for="message" class="cta-label">Tell us about your health</label><textarea id="message" name="message" maxlength="5000" data-name="message" placeholder="Enter your message" class="cta-input textarea-cta w-input"></textarea></div>
              </div><input type="submit" data-wait="Please wait..." class="cta-submit w-button" value="Submit">
            </form>
            <div class="success-message w-form-done">
              <div>Request received! We&#x27;ll call to confirm your visit.</div>
            </div>
            <div class="error-message w-form-fail">
              <div>We couldn&#x27;t book that request. Please try again shortly.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
