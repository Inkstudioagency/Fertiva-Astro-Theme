              <path d="M32.4373 6.65594C27.9678 3.91441 24.067 5.01921 21.7237 6.77904C20.7627 7.50063 20.2823 7.86141 19.9997 7.86141C19.717 7.86141 19.2367 7.50063 18.2757 6.77904C15.9324 5.01921 12.0315 3.91441 7.56207 6.65594C1.69646 10.2539 0.369205 22.1237 13.8989 32.1379C16.4759 34.0454 17.7643 34.9991 19.9997 34.9991C22.235 34.9991 23.5235 34.0454 26.1005 32.1379C39.6302 22.1237 38.3028 10.2539 32.4373 6.65594Z" stroke-width="2.5" stroke-linecap="round" stroke="currentColor"></path>
              <path d="M20 15V20M20 20V25M20 20H15M20 20H25" stroke-width="2.5" stroke-linecap="round" stroke="currentColor"></path>
            </svg>
            <div class="font-medium semibold">IVF Success Rate</div>
          </div>
          <div class="about-card-bottom">
            <div data-counter="counter" class="about-stats">92%</div>
            <p class="paragraph-regular">Based on eligible IVF treatment cycles with personalized care</p>
          </div>
        </div>
