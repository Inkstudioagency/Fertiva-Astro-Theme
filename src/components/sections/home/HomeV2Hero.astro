---
import Navbar from '../../global/Navbar.astro';
import PrimaryButton from '../../ui/PrimaryButton.astro';
---
<div class="hero-wrapper-v2">
  <Navbar variant="base" />
  <section class="section">
    <div class="container">
      <div class="v2-hero-grid">
        <div class="v2-hero-copy">
          <div class="v2-hero-top">
            <div class="badge home">
              <div class="badge-dot"></div>
              <div>Trusted women’s health clinic</div>
            </div>
            <h1 class="service-title home-v2">Personalized care for women’s health</h1>
            <p class="service-intro-text">From fertility and pregnancy to hormonal health and menopause, personalised care from specialists who take the time to listen.</p>
            <div class="v2-hero-actions">
              <div class="v2-buttons">
                <PrimaryButton href="/contact-v1" label="Book Appointment" />
                <PrimaryButton href="/services" label="Explore Services" variant="white" />
              </div>
              <div class="v2-proof">
                <div class="v2-avatars"><img src="/images/Avatar-Image-3_2Avatar-Image-3.webp" loading="lazy" width="128" height="128" alt="Smiling woman with curly hair wearing a light beige shirt." class="v2-avatar"><img src="/images/Avatar-Image-2_2Avatar-Image-2.webp" loading="lazy" width="128" height="128" alt="Portrait of a smiling young woman with dark hair tied back, wearing small hoop earrings and a dark top." class="v2-avatar"><img src="/images/Avatar-Image-1_1Avatar-Image-1.webp" loading="lazy" width="128" height="128" alt="Portrait of a young woman with short dark hair and a contemplative expression, looking slightly upward and to her left, wearing a sleeveless top." class="v2-avatar"><img src="/images/Avatar-Image-3_2Avatar-Image-3.webp" loading="lazy" width="128" height="128" alt="Smiling woman with curly hair wearing a light beige shirt." class="v2-avatar last"></div>
                <p class="v2-proof-text"><strong class="bold-text">Join 10,000+ women</strong> who trust us with their health journey</p>
              </div>
            </div>
          </div>
          <div class="v2-stats-card">
            <div class="v2-stat">
              <div data-counter="counter" class="v2-stat-value">28+</div>
              <div class="profile-text">Years of experience</div>
            </div>
            <div class="v2-stat-divider"></div>
            <div class="v2-stat">
              <div data-counter="counter" class="v2-stat-value">10k+</div>
              <div class="profile-text">Patients treated</div>
            </div>
            <div class="v2-stat-divider"></div>
            <div class="v2-stat">
              <div data-counter="counter" class="v2-stat-value">98%</div>
              <div class="profile-text">Satisfaction rate</div>
            </div>
          </div>
        </div>
        <div class="v2-hero-media"><img src="/images/Hero-image-7.webp" loading="lazy" width="1848" height="2064" alt="Couple smiling at a positive pregnancy test" srcset="/images/Hero-image-7-p-500.webp 500w, /images/Hero-image-7-p-800.webp 800w, /images/Hero-image-7-p-1080.webp 1080w, /images/Hero-image-7-p-1600.webp 1600w, /images/Hero-image-7.webp 1848w" sizes="(max-width: 1848px) 100vw, 1848px" class="care-bg-image">
          <div class="v2-chips">
            <div class="v2-chip">Fertility</div>
            <div class="v2-chip">Pregnancy</div>
            <div class="v2-chip">Hormones</div>
            <div class="v2-chip">Menopause</div>
            <div class="v2-chip">Wellness</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
