---
import Navbar from '../../global/Navbar.astro';
import PrimaryButton from '../../ui/PrimaryButton.astro';
---
<div class="hero-wrapper">
  <div class="hero-area-wrap">
    <Navbar variant="nav-v1" />
    <section class="section">
      <div class="container v1">
        <div class="home-hero-top">
          <div class="hero-heading-wrap">
            <h1 data-wf-target="[[[&quot;6b03d34f707687d1b49b565f&quot;,&quot;70f33ce9-955e-925e-714e-e4cb8f526b04&quot;],[]]]">Personalized care for women’s health</h1>
          </div>
          <div class="max-width-30">
            <p class="hero-summary">From therapy sessions to emotional tracking — our smart platform zconnects you to the right mental health experts.</p>
          </div>
          <div class="hero-button-wrap">
            <PrimaryButton href="/contact-v1" label="Book Appointment" />
            <PrimaryButton href="/contact-v1" label="Let’s Talk" variant="secondary" />
          </div>
        </div>
        <div class="home-hero-bottom">
          <div class="home-hero-left-card">
            <div class="hero-card-top">
              <div data-counter="counter" class="stats-text">3.5k+</div>
              <div class="font-small">lives supported globally by us</div>
            </div>
            <div class="reviewer-image-wrapper">
              <div class="reviewer-image-group"><img src="/images/Avatar-Image-2_1Avatar-Image-2.webp" loading="lazy" width="128" height="128" alt="Portrait of a young woman with short dark hair, wearing a sleeveless top, looking over her shoulder." class="hero-reviewer-image"><img src="/images/Avatar-Image-7_1Avatar-Image-7.webp" loading="lazy" width="128" height="128" alt="Portrait of a young woman with curly hair tied up, wearing a sleeveless beige top, standing outdoors with a blurred natural background during golden hour." class="hero-reviewer-image"><img src="/images/Avatar-Image-8_1Avatar-Image-8.webp" loading="lazy" width="128" height="128" alt="Smiling woman with curly hair wearing a light beige sweater." class="hero-reviewer-image"><img src="/images/Avatar-Image-9_1Avatar-Image-9.webp" loading="lazy" width="128" height="128" alt="Headshot of a smiling young woman with curly dark hair pulled back, wearing small hoop earrings and natural makeup." class="hero-reviewer-image"><img src="/images/Avatar-Image-3_1Avatar-Image-3.webp" loading="lazy" width="96" height="96" alt="Portrait of a young woman with curly hair pulled back, wearing a sleeveless white top, standing outdoors with cliffs and ocean." class="hero-reviewer-image"><img src="/images/Avatar-Image-2_1Avatar-Image-2.webp" loading="lazy" width="128" height="128" alt="Portrait of a young woman with short dark hair, wearing a sleeveless top, looking over her shoulder." class="hero-reviewer-image"><img src="/images/Avatar-Image-8_1Avatar-Image-8.webp" loading="lazy" width="128" height="128" alt="Smiling woman with curly hair wearing a light beige sweater." class="hero-reviewer-image"><img src="/images/Avatar-Image-2_1Avatar-Image-2.webp" loading="lazy" width="128" height="128" alt="Portrait of a young woman with short dark hair, wearing a sleeveless top, looking over her shoulder." class="hero-reviewer-image"><img src="/images/Avatar-Image-9_1Avatar-Image-9.webp" loading="lazy" width="128" height="128" alt="Headshot of a smiling young woman with curly dark hair pulled back, wearing small hoop earrings and natural makeup." class="hero-reviewer-image"><img src="/images/Avatar-Image-2_1Avatar-Image-2.webp" loading="lazy" width="128" height="128" alt="Portrait of a young woman with short dark hair, wearing a sleeveless top, looking over her shoulder." class="hero-reviewer-image"></div>
            </div>
          </div>
          <div class="hero-bottom-right">
            <div class="home-hero-pill">
              <div>Therapy</div>
            </div>
            <div class="home-hero-pill">
              <div>Mindfulness</div>
            </div>
            <div class="home-hero-pill">
              <div>Counseling</div>
            </div>
            <div class="home-hero-pill">
              <div>Depression</div>
            </div>
            <div class="home-hero-pill">
              <div>Anxiety</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
