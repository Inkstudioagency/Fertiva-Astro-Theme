---
import Navbar from '../../global/Navbar.astro';
import PrimaryButton from '../../ui/PrimaryButton.astro';
---
<div class="hero-wrap">
  <Navbar variant="base" />
  <section class="hero-section v3">
    <div class="container">
      <div class="v3-hero-content">
        <div class="v2-hero-top center">
          <h1 class="service-title">Personalized care for women’s health</h1>
          <p class="service-intro-text">From fertility and pregnancy to hormonal health and menopause personalised care from</p>
        </div>
        <div class="v3-hero-actions">
          <div class="v2-buttons">
            <PrimaryButton href="/contact-v1" label="Book Appointment" />
            <PrimaryButton href="/services" label="Explore Services" variant="white" />
          </div>
          <div class="v2-proof center">
            <div class="v2-avatars"><img src="/images/Avatar-Image-3_2Avatar-Image-3.webp" loading="lazy" width="128" height="128" alt="Smiling woman with curly hair wearing a light beige shirt." class="v2-avatar"><img src="/images/Avatar-Image-2_2Avatar-Image-2.webp" loading="lazy" width="128" height="128" alt="Portrait of a smiling young woman with dark hair tied back, wearing small hoop earrings and a dark top." class="v2-avatar"><img src="/images/Avatar-Image-1_1Avatar-Image-1.webp" loading="lazy" width="128" height="128" alt="Portrait of a young woman with short dark hair and a contemplative expression, looking slightly upward and to her left, wearing a sleeveless top." class="v2-avatar"><img src="/images/Avatar-Image_5Avatar-Image.webp" loading="lazy" width="96" height="96" alt="Portrait of a young woman with light curly hair wearing a white sleeveless top, standing outdoors at sunset with blurred cliffs and water." class="v2-avatar"></div>
            <p class="v2-proof-text center-mobile">Over <span class="highlight-text">10,000 women</span> rely on our clinic for their daily care</p>
          </div>
        </div>
      </div>
      <div class="v3-hero-media"><img class="story-img show" src="/images/Subtract-1.webp" width="3840" height="1716" alt="Couple reading a positive pregnancy test" data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;1510ddf0-e3af-874e-a429-1bb2599cce36&quot;],[]]]" sizes="(max-width: 3840px) 100vw, 3840px" loading="lazy" srcset="/images/Subtract-1-p-500.webp 500w, /images/Subtract-1-p-800.webp 800w, /images/Subtract-1-p-1080.webp 1080w, /images/Subtract-1-p-1600.webp 1600w, /images/Subtract-1-p-2000.webp 2000w, /images/Subtract-1-p-2600.webp 2600w, /images/Subtract-1-p-3200.webp 3200w, /images/Subtract-1.webp 3840w"><img class="story-img" src="/images/Subtract-2.webp" width="3840" height="1716" alt="Expectant mother at a prenatal check-up" data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;78ec7333-ffe7-de70-3a85-d13799a0ac0f&quot;],[]]]" sizes="(max-width: 3840px) 100vw, 3840px" loading="lazy" srcset="/images/Subtract-2-p-500.webp 500w, /images/Subtract-2-p-800.webp 800w, /images/Subtract-2-p-1080.webp 1080w, /images/Subtract-2-p-1600.webp 1600w, /images/Subtract-2-p-2000.webp 2000w, /images/Subtract-2-p-2600.webp 2600w, /images/Subtract-2-p-3200.webp 3200w, /images/Subtract-2.webp 3840w"><img class="story-img" src="/images/Subtract-3.webp" width="3840" height="1716" alt="Woman speaking with her doctor about hormone care" data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;7be0fb00-ebf2-b0b8-4d5f-39b77d9afd10&quot;],[]]]" sizes="(max-width: 3840px) 100vw, 3840px" loading="lazy" srcset="/images/Subtract-3-p-500.webp 500w, /images/Subtract-3-p-800.webp 800w, /images/Subtract-3-p-1080.webp 1080w, /images/Subtract-3-p-1600.webp 1600w, /images/Subtract-3-p-2000.webp 2000w, /images/Subtract-3-p-2600.webp 2600w, /images/Subtract-3.webp 3840w"><img class="story-img" src="/images/Subtract-4.webp" width="3840" height="1716" alt="Woman relaxing at home after a wellness visit" data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;0b4a2beb-1906-1b29-5fc2-e5278b3d426a&quot;],[]]]" sizes="(max-width: 3840px) 100vw, 3840px" loading="lazy" srcset="/images/Subtract-4-p-500.webp 500w, /images/Subtract-4-p-800.webp 800w, /images/Subtract-4-p-1080.webp 1080w, /images/Subtract-4-p-1600.webp 1600w, /images/Subtract-4-p-2000.webp 2000w, /images/Subtract-4-p-2600.webp 2600w, /images/Subtract-4-p-3200.webp 3200w, /images/Subtract-4.webp 3840w"><img src="/images/Rectangle.svg" loading="lazy" width="408" height="505" alt="" class="v3-hero-notch">
        <div class="proc-shade"></div>
        <div class="v3-hero-tabs">
          <div class="v3-hero-tab">
            <div class="v3-tab-track">
              <div data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;d23c5ef0-4d58-8ca2-3772-9bf0d72d587e&quot;],[]]]" class="v3-tab-fill"></div>
            </div>
            <p class="profile-text white">01. Fertility</p>
          </div>
          <div class="v3-hero-tab">
            <div class="v3-tab-track">
              <div data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;d23c5ef0-4d58-8ca2-3772-9bf0d72d5883&quot;],[]]]" class="v3-tab-fill"></div>
            </div>
            <p class="profile-text white">02. Pregnancy</p>
          </div>
          <div class="v3-hero-tab">
            <div class="v3-tab-track">
              <div data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;d23c5ef0-4d58-8ca2-3772-9bf0d72d5888&quot;],[]]]" class="v3-tab-fill"></div>
            </div>
            <p class="profile-text white">03. Hormonal Health</p>
          </div>
          <div class="v3-hero-tab">
            <div class="v3-tab-track">
              <div data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;d23c5ef0-4d58-8ca2-3772-9bf0d72d588d&quot;],[]]]" class="v3-tab-fill"></div>
            </div>
            <p class="profile-text white">04. Everyday Wellness</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
