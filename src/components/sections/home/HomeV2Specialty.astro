---
import PrimaryButton from '../../ui/PrimaryButton.astro';
---
<section data-wf-target="[[[&quot;6b03d34f707687d1b49b5674&quot;,&quot;dbfa76ff-fb93-65b9-32e3-7f6f66853703&quot;],[]]]" class="spec-section">
  <div class="spec-sticky">
    <div class="container">
      <div class="spec-grid">
        <div class="spec-copy">
          <div class="section-header speciality">
            <div class="badge">
              <div class="badge-dot"></div>
              <div>Speciality</div>
            </div>
            <h2 class="section-heading">Solutions for every kind of women’s health need</h2>
            <p to-top-2="" class="profile-text">Stay aware of how your body is changing, with specialists for every stage of life and your results kept in one secure place.</p>
          </div>
          <div to-top-2="">
            <PrimaryButton href="/contact-v1" label="Book Appointment" />
          </div>
          <div to-top-2="" class="v2-proof">
            <div class="spec-avatars"><img src="/images/Avatar-Image-3_2Avatar-Image-3.webp" loading="lazy" width="128" height="128" alt="Smiling woman with curly hair wearing a light beige shirt." class="v2-avatar"><img src="/images/Avatar-Image-2_2Avatar-Image-2.webp" loading="lazy" width="128" height="128" alt="Portrait of a smiling young woman with dark hair tied back, wearing small hoop earrings and a dark top." class="v2-avatar"><img src="/images/Avatar-Image-1_1Avatar-Image-1.webp" loading="lazy" width="128" height="128" alt="Portrait of a young woman with short dark hair and a contemplative expression, looking slightly upward and to her left, wearing a sleeveless top." class="v2-avatar"><img src="/images/Avatar-Image_5Avatar-Image.webp" loading="lazy" width="96" height="96" alt="Portrait of a young woman with light curly hair wearing a white sleeveless top, standing outdoors at sunset with blurred cliffs and water." class="v2-avatar">
              <div class="spec-avatar-more v2">40+</div>
            </div>
            <div>
              <div class="spec-proof-title">Board-certified specialists</div>
              <div class="spec-proof-text">Across 12 women’s health specialties</div>
            </div>
          </div>
        </div>
        <div to-top-4="" class="spec-arc">
          <div class="spec-wheel">
            <div class="spec-arm">
              <div class="spec-holder">
                <div class="spec-counter">
                  <div class="spec-spin">
                    <div class="spec-item"><img src="/images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36.webp" loading="lazy" width="4096" height="2731" alt="Fertility" srcset="/images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36-p-500.webp 500w, /images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36-p-800.webp 800w, /images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36-p-1080.webp 1080w, /images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36-p-1600.webp 1600w, /images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36-p-2000.webp 2000w, /images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36-p-2600.webp 2600w, /images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36-p-3200.webp 3200w, /images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36.webp 4096w" sizes="(max-width: 4096px) 100vw, 4096px" class="spec-photo">
                      <div class="spec-text">
                        <h3 class="spec-title">Fertility</h3>
                        <p class="spec-desc">Testing, tracking and treatment to help you grow your family.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="spec-arm a1">
              <div class="spec-holder">
                <div class="spec-counter c1">
                  <div class="spec-spin">
                    <div class="spec-item"><img src="/images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors..webp" loading="lazy" width="1208" height="1596" alt="Pregnancy" srcset="/images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors.-p-500.webp 500w, /images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors.-p-800.webp 800w, /images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors.-p-1080.webp 1080w, /images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors..webp 1208w" sizes="(max-width: 1208px) 100vw, 1208px" class="spec-photo">
                      <div class="spec-text">
                        <h3 class="spec-title">Pregnancy</h3>
                        <p class="spec-desc">Prenatal visits, scans and support through every trimester.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="spec-arm a2">
              <div class="spec-holder">
                <div class="spec-counter c2">
                  <div class="spec-spin">
                    <div class="spec-item"><img src="/images/Container-30.webp" loading="lazy" width="1200" height="1148" alt="Preventive Care" srcset="/images/Container-30-p-500.webp 500w, /images/Container-30-p-800.webp 800w, /images/Container-30-p-1080.webp 1080w, /images/Container-30.webp 1200w" sizes="(max-width: 1200px) 100vw, 1200px" class="spec-photo">
                      <div class="spec-text">
                        <h3 class="spec-title">Preventive Care</h3>
                        <p class="spec-desc">Screenings and check-ups that catch changes early and keep you well.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="spec-arm a3">
              <div class="spec-holder">
                <div class="spec-counter c3">
                  <div class="spec-spin">
                    <div class="spec-item"><img src="/images/Image-Pregnant-woman-in-striped-dress-with-young-boy-hugging-her-belly-outdoors..webp" loading="lazy" width="1208" height="1596" alt="Pediatrics" srcset="/images/Image-Pregnant-woman-in-striped-dress-with-young-boy-hugging-her-belly-outdoors.-p-500.webp 500w, /images/Image-Pregnant-woman-in-striped-dress-with-young-boy-hugging-her-belly-outdoors.-p-800.webp 800w, /images/Image-Pregnant-woman-in-striped-dress-with-young-boy-hugging-her-belly-outdoors.-p-1080.webp 1080w, /images/Image-Pregnant-woman-in-striped-dress-with-young-boy-hugging-her-belly-outdoors..webp 1208w" sizes="(max-width: 1208px) 100vw, 1208px" class="spec-photo">
                      <div class="spec-text">
                        <h3 class="spec-title">Pediatrics</h3>
                        <p class="spec-desc">Gentle, expert care for your little ones from day one.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="spec-arm a4">
              <div class="spec-holder">
                <div class="spec-counter c4">
                  <div class="spec-spin">
                    <div class="spec-item"><img src="/images/Container-31_1Container-31.webp" loading="lazy" width="400" height="240" alt="Hormonal Health" class="spec-photo">
                      <div class="spec-text">
                        <h3 class="spec-title">Hormonal Health</h3>
                        <p class="spec-desc">Balanced care for PCOS, thyroid and hormone concerns.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="spec-arm a5">
              <div class="spec-holder">
                <div class="spec-counter c5">
                  <div class="spec-spin">
                    <div class="spec-item"><img src="/images/photo-team-03-1.webp" loading="lazy" width="1725" height="1785" alt="Menopause Care" srcset="/images/photo-team-03-1-p-500.webp 500w, /images/photo-team-03-1-p-800.webp 800w, /images/photo-team-03-1-p-1080.webp 1080w, /images/photo-team-03-1-p-1600.webp 1600w, /images/photo-team-03-1.webp 1725w" sizes="(max-width: 1725px) 100vw, 1725px" class="spec-photo">
                      <div class="spec-text">
                        <h3 class="spec-title">Menopause Care</h3>
                        <p class="spec-desc">Personalised relief and long-term support through menopause.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="spec-arm a6">
              <div class="spec-holder">
                <div class="spec-counter c6">
                  <div class="spec-spin">
                    <div class="spec-item"><img src="/images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36.webp" loading="lazy" width="4096" height="2731" alt="Family Planning" srcset="/images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36-p-500.webp 500w, /images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36-p-800.webp 800w, /images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36-p-1080.webp 1080w, /images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36-p-1600.webp 1600w, /images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36-p-2000.webp 2000w, /images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36-p-2600.webp 2600w, /images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36-p-3200.webp 3200w, /images/b37a5531e46aa42cb78c7650b66a96f8e9d26d36.webp 4096w" sizes="(max-width: 4096px) 100vw, 4096px" class="spec-photo">
                      <div class="spec-text">
                        <h3 class="spec-title">Family Planning</h3>
                        <p class="spec-desc">Guidance to plan, prepare and grow your family on your terms.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="spec-arm a7">
              <div class="spec-holder">
                <div class="spec-counter c7">
                  <div class="spec-spin">
                    <div class="spec-item"><img src="/images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors..webp" loading="lazy" width="1208" height="1596" alt="Gynecology" srcset="/images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors.-p-500.webp 500w, /images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors.-p-800.webp 800w, /images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors.-p-1080.webp 1080w, /images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors..webp 1208w" sizes="(max-width: 1208px) 100vw, 1208px" class="spec-photo">
                      <div class="spec-text">
                        <h3 class="spec-title">Gynecology</h3>
                        <p class="spec-desc">Routine and specialist care for every stage of women&#x27;s health.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="spec-arm a8">
              <div class="spec-holder">
                <div class="spec-counter c8">
                  <div class="spec-spin">
                    <div class="spec-item"><img src="/images/Container-30.webp" loading="lazy" width="1200" height="1148" alt="Mental Wellbeing" srcset="/images/Container-30-p-500.webp 500w, /images/Container-30-p-800.webp 800w, /images/Container-30-p-1080.webp 1080w, /images/Container-30.webp 1200w" sizes="(max-width: 1200px) 100vw, 1200px" class="spec-photo">
                      <div class="spec-text">
                        <h3 class="spec-title">Mental Wellbeing</h3>
                        <p class="spec-desc">Emotional support for anxiety, stress and life after birth.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="spec-dot"></div>
          <div class="spec-fade"></div>
          <div class="spec-fade bottom"></div>
        </div>
      </div>
    </div>
  </div>
</section>
