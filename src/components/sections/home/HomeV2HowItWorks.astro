---
---
<section class="section worm-ivory">
  <div class="section-gap">
    <div class="container">
      <div class="section-header center">
        <div class="badge">
          <div class="badge-dot"></div>
          <div>Process</div>
        </div>
        <h2 class="section-heading center">How our care works</h2>
      </div>
      <div to-top-2="" class="proc-accordion">
        <div class="proc-col">
          <div class="proc-top">
            <div class="proc-step">Step 01</div>
            <div class="proc-icon">
              <div class="proc-bar"></div>
              <div class="proc-bar vertical"></div>
            </div>
          </div>
          <div class="proc-vtitle">Book Your Appointment</div>
          <div class="proc-body">
            <div class="proc-text-group">
              <h3 class="proc-title">Book Your Appointment</h3>
              <p class="proc-text">Choose a time online or call us, with same-week appointments available.</p>
            </div>
            <div class="proc-media"><img src="/images/Image-10.webp" loading="lazy" width="2360" height="1388" alt="Book Your Appointment" srcset="/images/Image-10-p-500.webp 500w, /images/Image-10-p-800.webp 800w, /images/Image-10-p-1080.webp 1080w, /images/Image-10-p-1600.webp 1600w, /images/Image-10-p-2000.webp 2000w, /images/Image-10.webp 2360w" sizes="(max-width: 2360px) 100vw, 2360px" class="care-bg-image">
              <div class="proc-shade"></div>
              <div class="proc-highlights">
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>Online booking</div>
                </div>
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>Same-week slots</div>
                </div>
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>SMS reminders</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="proc-col active">
          <div class="proc-top">
            <div class="proc-step active">Step 02</div>
            <div class="proc-icon">
              <div class="proc-bar"></div>
              <div class="proc-bar vertical active"></div>
            </div>
          </div>
          <div class="proc-vtitle active">Initial Consultation</div>
          <div class="proc-body active">
            <div class="proc-text-group">
              <h3 class="proc-title">Initial Consultation</h3>
              <p class="proc-text">An unhurried first visit to understand your health history, symptoms and goals.</p>
            </div>
            <div class="proc-media"><img src="/images/Image-9.webp" loading="lazy" width="1770" height="1041" alt="Initial Consultation" srcset="/images/Image-9-p-500.webp 500w, /images/Image-9-p-800.webp 800w, /images/Image-9-p-1080.webp 1080w, /images/Image-9-p-1600.webp 1600w, /images/Image-9.webp 1770w" sizes="(max-width: 1770px) 100vw, 1770px" class="care-bg-image">
              <div class="proc-shade"></div>
              <div class="proc-highlights">
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>60-minute visit</div>
                </div>
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>Full health history</div>
                </div>
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>Every question answered</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="proc-col">
          <div class="proc-top">
            <div class="proc-step">Step 03</div>
            <div class="proc-icon">
              <div class="proc-bar"></div>
              <div class="proc-bar vertical"></div>
            </div>
          </div>
          <div class="proc-vtitle">Tests &amp; Diagnosis</div>
          <div class="proc-body">
            <div class="proc-text-group">
              <h3 class="proc-title">Tests &amp; Diagnosis</h3>
              <p class="proc-text">In-house lab tests and scans give clear answers, explained in plain language.</p>
            </div>
            <div class="proc-media"><img src="/images/Image-11.webp" loading="lazy" width="2360" height="1388" alt="Tests and Diagnosis" srcset="/images/Image-11-p-500.webp 500w, /images/Image-11-p-800.webp 800w, /images/Image-11-p-1080.webp 1080w, /images/Image-11-p-1600.webp 1600w, /images/Image-11-p-2000.webp 2000w, /images/Image-11.webp 2360w" sizes="(max-width: 2360px) 100vw, 2360px" class="care-bg-image">
              <div class="proc-shade"></div>
              <div class="proc-highlights">
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>In-house lab</div>
                </div>
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>Results in days</div>
                </div>
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>Clear explanations</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="proc-col">
          <div class="proc-top">
            <div class="proc-step">Step 04</div>
            <div class="proc-icon">
              <div class="proc-bar"></div>
              <div class="proc-bar vertical"></div>
            </div>
          </div>
          <div class="proc-vtitle">Personalised Care Plan</div>
          <div class="proc-body">
            <div class="proc-text-group">
              <h3 class="proc-title">Personalised Care Plan</h3>
              <p class="proc-text">A plan built around your goals, with every option explained so you can choose with confidence.</p>
            </div>
            <div class="proc-media"><img src="/images/Image-12.webp" loading="lazy" width="2360" height="1388" alt="Personalised Care Plan" srcset="/images/Image-12-p-500.webp 500w, /images/Image-12-p-800.webp 800w, /images/Image-12-p-1080.webp 1080w, /images/Image-12-p-1600.webp 1600w, /images/Image-12-p-2000.webp 2000w, /images/Image-12.webp 2360w" sizes="(max-width: 2360px) 100vw, 2360px" class="care-bg-image">
              <div class="proc-shade"></div>
              <div class="proc-highlights">
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>Tailored to you</div>
                </div>
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>Clear costs upfront</div>
                </div>
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>Shared decisions</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="proc-col">
          <div class="proc-top">
            <div class="proc-step">Step 05</div>
            <div class="proc-icon">
              <div class="proc-bar"></div>
              <div class="proc-bar vertical"></div>
            </div>
          </div>
          <div class="proc-vtitle">Treatment &amp; Care</div>
          <div class="proc-body">
            <div class="proc-text-group">
              <h3 class="proc-title">Treatment &amp; Care</h3>
              <p class="proc-text">Ongoing treatment and follow-ups with the same specialist, every step of the way.</p>
            </div>
            <div class="proc-media"><img src="/images/Image-13.webp" loading="lazy" width="2360" height="1388" alt="Treatment and Care" srcset="/images/Image-13-p-500.webp 500w, /images/Image-13-p-800.webp 800w, /images/Image-13-p-1080.webp 1080w, /images/Image-13-p-1600.webp 1600w, /images/Image-13-p-2000.webp 2000w, /images/Image-13.webp 2360w" sizes="(max-width: 2360px) 100vw, 2360px" class="care-bg-image">
              <div class="proc-shade"></div>
              <div class="proc-highlights">
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>One dedicated specialist</div>
                </div>
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>Regular follow-ups</div>
                </div>
                <div class="proc-highlight"><svg fill="none" viewBox="0 0 20 20" width="100%" xmlns="http://www.w3.org/2000/svg" class="proc-plus proc-plus">
                    <path stroke-linecap="round" stroke-width="1.5" stroke="currentColor" d="M10 4.167v11.666M4.167 10h11.666"></path>
                  </svg>
                  <div>Support between visits</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
