---
import PrimaryButton from '../../ui/PrimaryButton.astro';
---
<section class="section primary-dark">
  <div class="section-gap">
    <div class="container">
      <div class="srv-head">
        <div class="section-header">
          <div class="badge dark">
            <div class="badge-dot white"></div>
            <div>Expertise</div>
          </div>
          <div class="max-width-45">
            <h2 class="section-heading white">Solutions for every kind of women’s health need</h2>
          </div>
        </div>
        <div to-top-2="" class="srv-head-side">
          <p class="profile-text white">Scroll through what makes care at Fertiva different, each one built around how women actually experience healthcare.</p>
        </div>
      </div>
      <div data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;c20c410b-0e5d-0b7a-4682-ce48aa15a686&quot;],[]]]" class="spec-section why">
        <div class="spec-sticky keep">
          <div class="why-panels">
            <div to-top-0="" class="why-list-card">
              <div data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;c20c410b-0e5d-0b7a-4682-ce48aa15a66e&quot;],[]]]" class="why-list">
                <p data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;c20c410b-0e5d-0b7a-4682-ce48aa15a65d&quot;],[]]]" class="why-item active">Prenatal Checkups</p>
                <p data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;c20c410b-0e5d-0b7a-4682-ce48aa15a65f&quot;],[]]]" class="why-item">Obstetric Consultations</p>
                <p data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;c20c410b-0e5d-0b7a-4682-ce48aa15a661&quot;],[]]]" class="why-item">Pregnancy Ultrasounds</p>
                <p data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;c20c410b-0e5d-0b7a-4682-ce48aa15a663&quot;],[]]]" class="why-item">Personalized Birth Plans</p>
                <p data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;c20c410b-0e5d-0b7a-4682-ce48aa15a665&quot;],[]]]" class="why-item">Prenatal Nutrition</p>
                <p data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;c20c410b-0e5d-0b7a-4682-ce48aa15a667&quot;],[]]]" class="why-item">Midwife Support</p>
                <p data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;c20c410b-0e5d-0b7a-4682-ce48aa15a669&quot;],[]]]" class="why-item">Childbirth Preparation</p>
                <p data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;c20c410b-0e5d-0b7a-4682-ce48aa15a66b&quot;],[]]]" class="why-item">Postpartum Care</p>
                <p data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;c20c410b-0e5d-0b7a-4682-ce48aa15a66d&quot;],[]]]" class="why-item">Breastfeeding Support</p>
              </div>
            </div>
            <div to-top-2="" class="why-media"><img class="story-img show" src="/images/Image-Story-image-1.webp" width="576" height="540" alt="Prenatal Checkups" data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;bd1d6e0c-a489-546d-1a90-f67372ebf3d6&quot;],[]]]" sizes="(max-width: 576px) 100vw, 576px" loading="lazy" srcset="/images/Image-Story-image-1-p-500.webp 500w, /images/Image-Story-image-1.webp 576w"><img class="story-img" src="/images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors..webp" width="1208" height="1596" alt="Obstetric Consultations" data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;a3682042-42cc-c6b8-7518-02c00506f94c&quot;],[]]]" sizes="(max-width: 1208px) 100vw, 1208px" loading="lazy" srcset="/images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors.-p-500.webp 500w, /images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors.-p-800.webp 800w, /images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors.-p-1080.webp 1080w, /images/Image-Smiling-pregnant-woman-in-light-blue-dress-gently-holding-her-belly-outdoors..webp 1208w"><img class="story-img" src="/images/Image-53.webp" width="2432" height="2496" alt="Pregnancy Ultrasounds" data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;24e6a7da-2686-58b0-0642-367f6c024661&quot;],[]]]" sizes="(max-width: 2432px) 100vw, 2432px" loading="lazy" srcset="/images/Image-53-p-500.webp 500w, /images/Image-53-p-800.webp 800w, /images/Image-53-p-1080.webp 1080w, /images/Image-53-p-1600.webp 1600w, /images/Image-53-p-2000.webp 2000w, /images/Image-53.webp 2432w"><img class="story-img" src="/images/Image-54.webp" width="1824" height="1872" alt="Personalized Birth Plans" data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;55356a23-49be-dbdc-76f0-4d67c237bbad&quot;],[]]]" sizes="(max-width: 1824px) 100vw, 1824px" loading="lazy" srcset="/images/Image-54-p-500.webp 500w, /images/Image-54-p-800.webp 800w, /images/Image-54-p-1080.webp 1080w, /images/Image-54-p-1600.webp 1600w, /images/Image-54.webp 1824w"><img class="story-img" src="/images/Image-56.webp" width="1824" height="1872" alt="Prenatal Nutrition" data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;c2802f36-3c52-87c6-e841-e3b82243ba75&quot;],[]]]" sizes="(max-width: 1824px) 100vw, 1824px" loading="lazy" srcset="/images/Image-56-p-500.webp 500w, /images/Image-56-p-800.webp 800w, /images/Image-56-p-1080.webp 1080w, /images/Image-56-p-1600.webp 1600w, /images/Image-56.webp 1824w"><img class="story-img" src="/images/Image-55.webp" width="1824" height="1872" alt="Midwife Support" data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;802f438c-b540-c07e-fb17-15f93a8730dd&quot;],[]]]" sizes="(max-width: 1824px) 100vw, 1824px" loading="lazy" srcset="/images/Image-55-p-500.webp 500w, /images/Image-55-p-800.webp 800w, /images/Image-55-p-1080.webp 1080w, /images/Image-55-p-1600.webp 1600w, /images/Image-55.webp 1824w"><img class="story-img" src="/images/Image-58.webp" width="1824" height="1872" alt="Childbirth Preparation" data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;79db6106-20e7-cd95-162d-f7eb34bf78f6&quot;],[]]]" sizes="(max-width: 1824px) 100vw, 1824px" loading="lazy" srcset="/images/Image-58-p-500.webp 500w, /images/Image-58-p-800.webp 800w, /images/Image-58-p-1080.webp 1080w, /images/Image-58-p-1600.webp 1600w, /images/Image-58.webp 1824w"><img class="story-img" src="/images/Image-57.webp" width="2432" height="2496" alt="Postpartum Care" data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;290a9a8d-355a-c314-f0e2-41b52cd3e739&quot;],[]]]" sizes="(max-width: 2432px) 100vw, 2432px" loading="lazy" srcset="/images/Image-57-p-500.webp 500w, /images/Image-57-p-800.webp 800w, /images/Image-57-p-1080.webp 1080w, /images/Image-57-p-1600.webp 1600w, /images/Image-57-p-2000.webp 2000w, /images/Image-57.webp 2432w"><img class="story-img" src="/images/Image-59.webp" width="1824" height="1872" alt="Breastfeeding Support" data-wf-target="[[[&quot;6b03d34f707687d1b49b567a&quot;,&quot;3d28986e-ecff-7110-e02e-46934fbc62b3&quot;],[]]]" sizes="(max-width: 1824px) 100vw, 1824px" loading="lazy" srcset="/images/Image-59-p-500.webp 500w, /images/Image-59-p-800.webp 800w, /images/Image-59-p-1080.webp 1080w, /images/Image-59-p-1600.webp 1600w, /images/Image-59.webp 1824w"></div>
          </div>
          <div to-top-0="" class="why-cta">
            <div class="why-cta-left">
              <div class="spec-avatars"><img src="/images/Avatar-Image-3_2Avatar-Image-3.webp" loading="lazy" width="128" height="128" alt="Smiling woman with curly hair wearing a light beige shirt." class="v2-avatar"><img src="/images/Avatar-Image-2_2Avatar-Image-2.webp" loading="lazy" width="128" height="128" alt="Portrait of a smiling young woman with dark hair tied back, wearing small hoop earrings and a dark top." class="v2-avatar"><img src="/images/Avatar-Image-1_1Avatar-Image-1.webp" loading="lazy" width="128" height="128" alt="Portrait of a young woman with short dark hair and a contemplative expression, looking slightly upward and to her left, wearing a sleeveless top." class="v2-avatar">
                <div class="spec-avatar-more light-v3">40+</div>
              </div>
              <div class="spec-text">
                <p class="spec-proof-title white">Highly trained specialists</p>
                <p class="spec-proof-text white">Covering 12 areas of women’s care</p>
              </div>
            </div>
            <PrimaryButton href="/contact-v1" label="Book Appointment" variant="with-border" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
