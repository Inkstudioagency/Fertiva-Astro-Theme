---
import { getDoctors, getDoctorCategories } from '../../../lib/cms';

const doctors = await getDoctors();
const tabs = (await getDoctorCategories()).map((label) => ({ label, doctors: doctors.filter((d) => d.category === label) }));
---
<section class="section primary-dark">
  <div class="section-gap">
    <div class="container">
      <div class="section-header center">
        <div class="inner-badge-v3">
          <div class="badge-dot white"></div>
          <div>Doctors</div>
        </div>
        <h2 heading-rebuild="" class="section-heading white center">The Leading Health Experts</h2>
      </div>
      <div data-current="Tab 1" data-easing="ease" data-duration-in="300" data-duration-out="100" class="doctor-tabs-v3 w-tabs">
        <div to-top-0="" class="doctor-tab-menu-v3 w-tab-menu">
          {tabs.map((tab, i) => (
            <a data-w-tab={`Tab ${i + 1}`} class:list={['doctor-tab-link w-inline-block w-tab-link', i === 0 && 'w--current']}>
              <div>{tab.label}</div>
            </a>
          ))}
        </div>
        <div to-top-2="" class="doctor-tab-content-v3 w-tab-content">
          {tabs.map((tab, i) => (
            <div data-w-tab={`Tab ${i + 1}`} class:list={['doctor-tab-pane w-tab-pane', i === 0 && 'w--tab-active']}>
              <div class="w-dyn-list">
                <div role="list" class="doctor-collection-list w-dyn-items">
                  {tab.doctors.map((d) => (
                    <div role="listitem" class="w-dyn-item">
                      <a href={d.url} class="doctor-card-v3 w-inline-block"><img src={d.photo.src} srcset={d.photo.srcset} loading="lazy" width="1644" height="2024" alt={d.photo.alt} class="doctor-card-image">
                        <div class="doctor-card-info-v3">
                          <div class="doctor-card-top">
                            <h3 class="doctor-card-name">{d.name}</h3>
                            <div class="doctor-card-link"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="doctor-card-icon">
                                <path d="M7.50033 5.54193C7.50033 5.54193 13.2822 5.08966 14.0965 5.90386C14.9107 6.71806 14.4583 12.5 14.4583 12.5M13.7503 6.25L5.41699 14.5833" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
                              </svg></div>
                          </div>
                          <div class="team-info-wrap">
                            <div class="doctor-card-stats-v3">
                              <div class="doctor-stat">
                                <div class="doctor-stat-label">Exp</div>
                                <div class="doctor-stat-value">{d.experience}</div>
                              </div>
                              <div class="doctor-stat">
                                <div class="doctor-stat-label">Duty time</div>
                                <div class="doctor-stat-value">{d.dutyTime}</div>
                              </div>
                              <div class="doctor-stat">
                                <div class="doctor-stat-label">Surgeries</div>
                                <div class="doctor-stat-value">{d.surgeries}</div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </a>
                    </div>
                  ))}
                </div>
                {tab.doctors.length === 0 && (<div class="w-dyn-empty"><div>No items found.</div></div>)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
