---
/**
 * Password page design (from the original Webflow utility page).
 * A static site cannot check passwords: protect pages with your host's password
 * protection (Netlify, Vercel, Cloudflare Access…) instead. Submitting this form
 * only shows the error state.
 */
---
<div class="utility-page-wrap">
  <div class="utility-page-content w-password-page w-form">
    <form id="wf-form-Password-Form" name="wf-form-Password-Form" data-name="Password Form" class="utility-page-form w-password-page" data-password-form>
      <img src="/images/401-img.avif" alt="" width="469" height="264" class="_401-image">
      <div class="password-info-wrap">
        <h1 class="password-heading">Protected Page</h1>
        <p>This page is encrypted and requires a password to view. Please enter the access code provided by your administrator.</p>
      </div>
      <div class="password-field-wrap">
        <label for="pass" class="field-label w-password-page">Password</label>
        <input class="cta-input password w-password-page w-input" autofocus maxlength="256" name="pass" data-name="field" placeholder="Enter your password" type="password" id="pass">
      </div>
      <input type="submit" data-wait="Please wait..." class="cta-submit w-password-page w-button" value="Submit">
      <div class="error-message w-password-page w-form-fail">
        <div>Incorrect password. Please try again.</div>
      </div>
    </form>
  </div>
</div>
<script is:inline>
  // Runs before webflow.js form handling (capture phase) so nothing is sent anywhere.
  window.addEventListener(
    'submit',
    (event) => {
      const form = event.target.closest('[data-password-form]');
      if (!form) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      form.querySelector('.w-form-fail').style.display = 'block';
    },
    true
  );
</script>
