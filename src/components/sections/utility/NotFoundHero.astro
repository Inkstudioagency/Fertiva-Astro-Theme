---
import Navbar from '../../global/Navbar.astro';
import PrimaryButton from '../../ui/PrimaryButton.astro';
---
<div class="hero-wrapper-v2">
  <Navbar variant="base" />
  <section class="section">
    <div class="section-gap">
      <div class="w-layout-blockcontainer container w-container">
        <div class="not-found-content-block">
          <div class="not-found-text-block">
            <h1 class="not-found-text">4<span class="not-found-ht-text">0</span>4</h1>
            <h2 data-wf-target="[[[&quot;6b03d34f707687d1b49b5666&quot;,&quot;deb223b9-c449-3a7c-96aa-088f5d7901d4&quot;],[]]]" class="_404-heading">Page Not Found!</h2>
            <div class="_404 align-center">The page you are looking for doesn&#x27;t exist or has been moved</div>
          </div>
          <div class="not-found-button-block">
            <PrimaryButton href="/" label="Back Home" />
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
