---
---
<section class="section primary-dark">
  <div class="section-gap">
    <div class="container">
      <div class="section-header center">
        <div class="badge">
          <div class="badge-dot"></div>
          <div>Journey</div>
        </div>
        <div class="max-width-34">
          <h2 class="section-heading white center">A decade of care, one family at a time</h2>
        </div>
      </div>
    </div>
    <div class="story-sticky-wrap">
      <div class="story-sticky">
        <div class="container">
          <div class="story-bottom">
            <div class="story-all-card-wrap">
              <div class="story-all-card-group">
                <div class="story-single-card"><img src="/images/Container-46.webp" loading="lazy" width="1897" height="1116" alt="Three healthcare workers smiling and standing close together in a hospital hallway, wearing scrubs with two women on either side and a man in the middle." srcset="/images/Container-46-p-500.webp 500w, /images/Container-46-p-800.webp 800w, /images/Container-46-p-1080.webp 1080w, /images/Container-46-p-1600.webp 1600w, /images/Container-46.webp 1897w" sizes="(max-width: 1897px) 100vw, 1897px" class="story-image">
                  <p class="story-summary">Fertiva opened its first clinic, offering calm, specialist care for women and families.</p>
                </div>
                <div class="story-single-card"><img src="/images/Container-6.webp" loading="lazy" width="1897" height="1116" alt="Five smiling doctors in white coats standing in front of the glass entrance of a clinic building." srcset="/images/Container-6-p-500.webp 500w, /images/Container-6-p-800.webp 800w, /images/Container-6-p-1080.webp 1080w, /images/Container-6-p-1600.webp 1600w, /images/Container-6.webp 1897w" sizes="(max-width: 1897px) 100vw, 1897px" class="story-image">
                  <p class="story-summary">Testing and treatment planning moved under one roof when our own fertility lab first opened.</p>
                </div>
                <div class="story-single-card"><img src="/images/Container-7.webp" loading="lazy" width="1897" height="1116" alt="Young female doctor in a white coat standing in a bright clinic hallway with medical staff talking behind her." srcset="/images/Container-7-p-500.webp 500w, /images/Container-7-p-800.webp 800w, /images/Container-7-p-1080.webp 1080w, /images/Container-7-p-1600.webp 1600w, /images/Container-7.webp 1897w" sizes="(max-width: 1897px) 100vw, 1897px" class="story-image">
                  <p class="story-summary">We introduced secure video consultations so patients could meet specialists from home.</p>
                </div>
                <div class="story-single-card"><img src="/images/Container-5.webp" loading="lazy" width="1897" height="1116" alt="Group of diverse smiling healthcare professionals wearing white coats and stethoscopes giving a high-five together." srcset="/images/Container-5-p-500.webp 500w, /images/Container-5-p-800.webp 800w, /images/Container-5-p-1080.webp 1080w, /images/Container-5-p-1600.webp 1600w, /images/Container-5.webp 1897w" sizes="(max-width: 1897px) 100vw, 1897px" class="story-image">
                  <p class="story-summary">A dedicated maternity wing opened with private suites and a 24/7 nurse support line.</p>
                </div>
                <div class="story-single-card"><img src="/images/Container-8.webp" loading="lazy" width="1897" height="1116" alt="Three smiling doctors in white coats reviewing an X-ray scan together inside a clinic room." srcset="/images/Container-8-p-500.webp 500w, /images/Container-8-p-800.webp 800w, /images/Container-8-p-1080.webp 1080w, /images/Container-8-p-1600.webp 1600w, /images/Container-8.webp 1897w" sizes="(max-width: 1897px) 100vw, 1897px" class="story-image">
                  <p class="story-summary">Today we support thousands of families each year, and our team keeps growing with them.</p>
                </div>
              </div>
            </div>
            <div class="story-line-wrap"><img src="/images/Frame-2147235529_1Frame-2147235529.webp" loading="lazy" width="5040" height="588" alt="Dark gray rectangular grid with thin vertical lines and thicker vertical orange lines at regular intervals." srcset="/images/Frame-2147235529_1-p-500.png 500w, /images/Frame-2147235529_1-p-1080.png 1080w, /images/Frame-2147235529_1-p-1600.png 1600w, /images/Frame-2147235529_1-p-2000.png 2000w, /images/Frame-2147235529_1-p-2600.png 2600w, /images/Frame-2147235529_1Frame-2147235529.webp 5040w" sizes="(max-width: 5040px) 100vw, 5040px" class="story-line">
              <div class="story-all-line"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 18" fill="none" class="story-icon">
                  <path d="M8.36094 17.0653C9.10889 18.3065 10.575 18.3065 11.323 17.0653L19.293 3.83941C20.2382 2.27089 19.3623 0 17.8119 0H1.87195C0.321698 0 -0.554282 2.27089 0.390924 3.83941L8.36094 17.0653Z" fill="currentColor"></path>
                </svg>
                <div class="story-vertical-line"></div>
                <div class="story-all-text-wrap">
                  <div class="all-text-group">
                    <div class="step-text-wrap">
                      <div class="story-step-text">2018</div>
                      <div class="story-step-text">2020</div>
                      <div class="story-step-text">2022</div>
                      <div class="story-step-text">2024</div>
                      <div class="story-step-text">2026</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
