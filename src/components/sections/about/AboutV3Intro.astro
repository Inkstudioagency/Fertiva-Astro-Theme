---
import PrimaryButton from '../../ui/PrimaryButton.astro';
---
<section class="section intro">
  <div class="section-gap">
    <div class="container">
      <div class="intro-wrapper">
        <div class="section-header center">
          <div class="badge">
            <div class="badge-dot"></div>
            <div>Who We Are</div>
          </div>
          <div class="rebuilt-text-wrap">
            <h2 class="v2-about-heading">Where specialist care meets genuine compassion. Fertiva brings fertility, pregnancy and women’s health experts under one roof </h2>
          </div>
          <div to-top-2="">
            <PrimaryButton href="/contact-v1" label="Book Appointment" />
          </div>
        </div>
        <div class="intro-grid">
          <div class="intro-image-wrap _01"><img src="/images/Image-Story-image-1.webp" loading="lazy" width="576" height="540" alt="A healthcare professional in a white coat explaining medication details on a blister pack to a woman wearing a pink shirt and beige cardigan during a consultation." srcset="/images/Image-Story-image-1-p-500.webp 500w, /images/Image-Story-image-1.webp 576w" sizes="(max-width: 576px) 100vw, 576px" class="intro-image"></div>
          <div class="intro-image-wrap _02"><img src="/images/Image-Story-image.webp" loading="lazy" width="576" height="540" alt="Two women, one with long dark hair wearing a beige cardigan and the other with curly red hair wearing a green shirt, look attentively at a thermometer held by the woman with red hair." srcset="/images/Image-Story-image-p-500.webp 500w, /images/Image-Story-image.webp 576w" sizes="(max-width: 576px) 100vw, 576px" class="intro-image"></div>
          <div class="intro-image-wrap"><img src="/images/Image-Story-image-2.webp" loading="lazy" width="1536" height="768" alt="Female doctor with stethoscope showing something on a tablet to a baby held by the mother on a couch." srcset="/images/Image-Story-image-2-p-500.webp 500w, /images/Image-Story-image-2-p-800.webp 800w, /images/Image-Story-image-2-p-1080.webp 1080w, /images/Image-Story-image-2.webp 1536w" sizes="(max-width: 1536px) 100vw, 1536px" class="intro-image"></div>
          <div class="intro-image-wrap _02"><img src="/images/Image-Story-image-3.webp" loading="lazy" width="768" height="720" alt="A female doctor in a white coat showing information on a tablet to a mother holding her baby with a pacifier, who is sitting on a baby scale covered with a gray polka dot blanket." srcset="/images/Image-Story-image-3-p-500.webp 500w, /images/Image-Story-image-3.webp 768w" sizes="(max-width: 767px) 100vw, 768px" class="intro-image"></div>
          <div class="intro-image-wrap _01"><img src="/images/Image-Story-image-4.webp" loading="lazy" width="768" height="720" alt="Smiling female doctor using a stethoscope to examine a pregnant woman&#x27;s belly while the woman lies on a medical bed, both appearing happy during a prenatal checkup." srcset="/images/Image-Story-image-4-p-500.webp 500w, /images/Image-Story-image-4.webp 768w" sizes="(max-width: 767px) 100vw, 768px" class="intro-image"></div>
        </div>
        <div to-top-2="" class="contact-logos">
          <p class="offered-intro">Over 4,700 families have trusted our care team</p>
          <div class="marque-list-wrap">
            <div class="marque-list">
              <div class="marque-logo-wrap pill ivory"><img src="/images/f843e1ff0cdb8a177b7ec13832849263a20dd5a3-89x22.svg.webp" loading="lazy" width="356" height="88" alt="Partner logo" class="company-logo"></div>
              <div class="marque-logo-wrap pill ivory"><img src="/images/0d49e11a3ac5f5842258059aa6b076afc688f037-134x25.svg.webp" loading="lazy" width="467" height="87" alt="Partner logo" class="company-logo"></div>
              <div class="marque-logo-wrap pill ivory"><img src="/images/42836d7889e05c15a3da0df6b06d352dd9f430b9-76x26.svg.webp" loading="lazy" width="304" height="104" alt="Partner logo" class="company-logo"></div>
              <div class="marque-logo-wrap pill ivory"><img src="/images/ebdb925c7e77d1de49cd17e31dd9d81833d48d0e-109x21.svg.webp" loading="lazy" width="436" height="84" alt="Partner logo" class="company-logo"></div>
              <div class="marque-logo-wrap pill ivory"><img src="/images/2ac784a8503062f6f9421444a3a1bcb3c2e8cfd4-65x19.svg.webp" loading="lazy" width="260" height="76" alt="Partner logo" class="company-logo"></div>
              <div class="marque-logo-wrap pill ivory"><img src="/images/cf18d167e431e5eb463dbbb1a020470e51615735-81x24.svg.webp" loading="lazy" width="324" height="96" alt="Partner logo" class="company-logo"></div>
              <div class="marque-logo-wrap pill ivory"><img src="/images/4ac63f5b7e621f83c117de669d0f72170d96caf0-100x21.svg.webp" loading="lazy" width="400" height="84" alt="Partner logo" class="company-logo"></div>
              <div class="marque-logo-wrap pill ivory"><img src="/images/f63b2435e49d879caa8bb6187fd07b667ad224c2-108x27.svg.webp" loading="lazy" width="432" height="108" alt="Partner logo" class="company-logo"></div>
            </div>
            <div aria-hidden="true" class="marque-list">
              <div class="marque-logo-wrap pill ivory"><img src="/images/f843e1ff0cdb8a177b7ec13832849263a20dd5a3-89x22.svg.webp" loading="lazy" width="356" height="88" alt="OdeaoLabs logo with a grey pixel grid icon next to the word OdeaoLabs." class="company-logo"></div>
              <div class="marque-logo-wrap pill ivory"><img src="/images/0d49e11a3ac5f5842258059aa6b076afc688f037-134x25.svg.webp" loading="lazy" width="467" height="87" alt="Norse Star logo with an eight-point star icon next to the words Norse Star." class="company-logo"></div>
              <div class="marque-logo-wrap pill ivory"><img src="/images/42836d7889e05c15a3da0df6b06d352dd9f430b9-76x26.svg.webp" loading="lazy" width="304" height="104" alt="Eightball logo with a dark circle icon next to the word Eightball." class="company-logo"></div>
              <div class="marque-logo-wrap pill ivory"><img src="/images/ebdb925c7e77d1de49cd17e31dd9d81833d48d0e-109x21.svg.webp" loading="lazy" width="436" height="84" alt="FocalPoint logo with a sunburst line icon next to the word FocalPoint." class="company-logo"></div>
              <div class="marque-logo-wrap pill ivory"><img src="/images/2ac784a8503062f6f9421444a3a1bcb3c2e8cfd4-65x19.svg.webp" loading="lazy" width="260" height="76" alt="Leapyear logo with a curved block icon next to the word Leapyear." class="company-logo"></div>
              <div class="marque-logo-wrap pill ivory"><img src="/images/cf18d167e431e5eb463dbbb1a020470e51615735-81x24.svg.webp" loading="lazy" width="324" height="96" alt="Frequencii logo with layered grey wave shapes next to the word Frequencii." class="company-logo"></div>
              <div class="marque-logo-wrap pill ivory"><img src="/images/4ac63f5b7e621f83c117de669d0f72170d96caf0-100x21.svg.webp" loading="lazy" width="400" height="84" alt="OdeaoLabs logo with a grey pixel grid icon next to the word OdeaoLabs." class="company-logo"></div>
              <div class="marque-logo-wrap pill ivory"><img src="/images/f63b2435e49d879caa8bb6187fd07b667ad224c2-108x27.svg.webp" loading="lazy" width="432" height="108" alt="Mastermail logo with four rounded diamond shapes next to the word Mastermail." class="company-logo"></div>
            </div>
            <div class="marque-overlay"></div>
            <div class="marque-overlay right"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
