---
import Navbar from '../../global/Navbar.astro';
import PrimaryButton from '../../ui/PrimaryButton.astro';
---
<div class="hero-wrapper">
  <div class="service-hero-area">
    <Navbar variant="nav-v1" />
    <section class="section">
      <div class="container v1">
        <div class="inner-hero">
          <div class="inner-left">
            <div class="inner-badge black-32">
              <div class="badge-dot white"></div>
              <div>services</div>
            </div>
            <h1 class="hero-heading">Comprehensive services for women’s health</h1>
          </div>
          <div class="inner-hero-right">
            <p class="paragraph-regular white">From routine gynecological care to personalized pregnancy support, our services are designed to guide women through every phase with comfort, clarity, and clinical expertise.</p>
            <PrimaryButton href="/contact-v1" label="Book Appointment" />
          </div>
        </div>
      </div>
    </section>
    <div class="inner-hero-overlay"></div>
  </div>
</div>
