---
import PrimaryButton from '../../ui/PrimaryButton.astro';
import { getServices } from '../../../lib/cms';

const services = await getServices();
---
<section class="section light">
  <div class="section-gap">
    <div class="container">
      <div class="section-header">
        <div class="badge">
          <div class="badge-dot"></div>
          <div>Care areas</div>
        </div>
        <h2 class="section-heading narrow">Specialized Services Built Around Women’s Real Needs</h2>
      </div>
      <div class="service-wrapper">
        {services.map((service) => (
          <div class="service-collection-wrap">
            <div class="w-dyn-list">
              <div role="list" class="service-row-list w-dyn-items">
                {[service].map((s) => (
                  <div role="listitem" class="w-dyn-item">
                    <div class="service-row">
                      <div class="service-row-info">
                        <div class="service-row-text">
                          <h3 class="service-row-title">{s.name}</h3>
                          <p class="service-row-summary">{s.summary}</p>
                        </div>
                        <div class="service-row-includes">
                          <div class="service-row-label">Includes</div>
                          <div class="service-row-features">
                            <div class="service-row-feature">{s.features[0]}</div>
                            <div class="service-row-feature">{s.features[1]}</div>
                            <div class="service-row-feature">{s.features[2]}</div>
                            <div class="service-row-feature">{s.features[3]}</div>
                          </div>
                        </div>
                        <PrimaryButton href={s.url} label="View service" />
                      </div>
                      <a href={s.url} class="service-row-image-wrap w-inline-block"><img src={s.image.src} srcset={s.image.srcset} loading="lazy" width="2060" height="1296" alt={s.image.alt} class="service-row-image">
                        <div class="demo">#</div>
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
