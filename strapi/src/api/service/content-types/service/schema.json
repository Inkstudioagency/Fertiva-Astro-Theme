{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "Treatments and services offered by the clinic"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "number": {
      "type": "string",
      "maxLength": 4,
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "required": true
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item",
      "max": 4
    },
    "overview": {
      "type": "blocks"
    },
    "cardsHeading": {
      "type": "string"
    },
    "cards": {
      "type": "component",
      "repeatable": true,
      "component": "shared.card",
      "max": 4
    },
    "cost": {
      "type": "blocks"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "closing": {
      "type": "blocks"
    },
    "quote": {
      "type": "text"
    },
    "quoteAuthor": {
      "type": "string"
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item",
      "max": 4
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
