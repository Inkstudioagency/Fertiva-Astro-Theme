# Public URL of the deployed site (canonical URLs, Open Graph tags, sitemap)
SITE_URL=https://your-domain.com

# Strapi CMS (see ./strapi). Leave empty or remove to build from the bundled
# snapshot in src/data/cms-snapshot.json.
STRAPI_URL=http://localhost:1337

# Optional read-only API token (Strapi admin → Settings → API Tokens).
# Only required if the Public role has no find/findOne permission on services, doctors and articles.
STRAPI_TOKEN=
